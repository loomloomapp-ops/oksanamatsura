GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:Z

# Email notifications (resend.com)
RESEND_API_KEY=
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=mariiakarpuk.smm@gmail.com
