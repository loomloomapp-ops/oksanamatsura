# Public address of the site (canonical, hreflang, sitemap). Domain not chosen yet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 0 for production: hides the "client material" placeholders.
NEXT_PUBLIC_SHOW_PENDING=1

